DB_PATH=/var/lib/handari/handari.sqlite
BACKUP_DIRECTORY=/var/backups/handari
BACKUP_ENCRYPTION_KEY_FILE=/var/lib/handari/backup.key
BACKUP_RETENTION_DAYS=30
# Set these only after the other server is ready. No passwords here.
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_PORT=22
BACKUP_REMOTE_USER=
BACKUP_REMOTE_DIRECTORY=
BACKUP_SSH_IDENTITY=/var/lib/handari/ssh/backup_ed25519
BACKUP_KNOWN_HOSTS=/var/lib/handari/ssh/known_hosts
